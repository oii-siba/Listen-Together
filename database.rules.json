{
  "rules": {
    ".read": false,
    ".write": false,

    "app_stats": {
      ".read": true,
      ".write": "auth != null"
    },

    "app_installs": {
      ".read": false,
      "$installId": {
        ".write": "auth != null || !data.exists()"
      }
    },

    "friend_directory": {
      ".read": true,
      "$code": {
        ".write": "auth != null && (newData.child('uid').val() === auth.uid || (data.exists() && data.child('uid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['uid', 'friendCode', 'name'])"
      }
    },

    "friend_directory_uids": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && ($uid === auth.uid)",
        ".validate": "newData.hasChildren(['uid', 'friendCode', 'name'])"
      }
    },

    "users": {
      "$uid": {
        "profile": {
          ".read": true,
          ".write": "auth != null && auth.uid === $uid"
        },
        "presence": {
          ".read": true,
          ".write": "auth != null && auth.uid === $uid"
        },
        "favorites": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "history": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "friends": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "notifications": {
          ".read": "auth != null && auth.uid === $uid",
          "$notifId": {
            ".write": "auth != null && (auth.uid === $uid || (!data.exists() && newData.child('senderUid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['type', 'senderUid', 'targetUid'])"
          }
        }
      }
    },

    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": "auth != null && (!data.exists() && newData.child('hostId').val() === auth.uid)",

        "hostId": {
          ".write": "auth != null && (data.val() === auth.uid || !data.exists())"
        },

        "playback": {
          ".write": "auth != null && (data.parent().child('hostId').val() === auth.uid || newData.parent().child('hostId').val() === auth.uid)"
        },

        "queue": {
          ".write": "auth != null && (data.parent().child('hostId').val() === auth.uid || newData.parent().child('hostId').val() === auth.uid)",
          "$qid": {
            ".write": "auth != null && (data.parent().parent().child('hostId').val() === auth.uid || (!data.exists() && newData.child('addedBy').val() === auth.uid && data.parent().parent().child('allowGuestAdd').val() !== false) || (data.exists() && data.child('addedBy').val() === auth.uid))"
          }
        },

        "chat": {
          ".write": "auth != null && (data.parent().child('hostId').val() === auth.uid || data.parent().child('allowGuestChat').val() !== false)",
          "$mid": {
            ".write": "auth != null && !data.exists() && newData.child('senderUid').val() === auth.uid && data.parent().parent().child('allowGuestChat').val() !== false",
            ".validate": "newData.hasChildren(['senderUid', 'text']) && newData.child('text').isString() && newData.child('text').val().length <= 500"
          }
        },

        "reactions": {
          ".write": "auth != null && (data.parent().child('hostId').val() === auth.uid || data.parent().child('allowGuestReactions').val() !== false)"
        },

        "activity": {
          ".write": "auth != null"
        },

        "presence": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || data.parent().parent().child('hostId').val() === auth.uid)"
          }
        },

        "kickedUsers": {
          "$uid": {
            ".write": "auth != null && (root.child('rooms').child($roomId).child('hostId').val() === auth.uid || (data.exists() && data.parent().parent().child('hostId').val() === auth.uid))"
          }
        },

        "roomPin": {
          ".write": "auth != null && (data.parent().child('hostId').val() === auth.uid || newData.parent().child('hostId').val() === auth.uid)"
        },

        "allowGuestAdd": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid"
        },
        "allowGuestChat": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid"
        },
        "allowGuestReactions": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid"
        }
      }
    }
  }
}

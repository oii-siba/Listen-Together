{
  "rules": {
    "app_stats": {
      ".read": true,
      ".write": true
    },
    "app_installs": {
      ".read": true,
      "$installId": {
        ".write": true
      }
    },
    "friend_directory": {
      ".read": true,
      "$code": {
        ".write": true
      }
    },
    "friend_directory_uids": {
      ".read": true,
      "$uid": {
        ".write": true
      }
    },
    "users": {
      "$uid": {
        ".read": true,
        ".write": true,
        "profile": {
          ".read": true,
          ".write": true
        },
        "favorites": {
          ".read": true,
          ".write": true
        },
        "history": {
          ".read": true,
          ".write": true
        },
        "friends": {
          ".read": true,
          ".write": true
        },
        "notifications": {
          ".read": true,
          ".write": true
        }
      }
    },
    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": true,
        "playback": {
          ".write": true
        },
        "queue": {
          ".write": true,
          "$qid": {
            ".write": true
          }
        },
        "chat": {
          ".write": true,
          "$mid": {
            ".write": true,
            ".validate": "newData.hasChildren(['senderUid', 'text']) && newData.child('text').isString() && newData.child('text').val().length <= 500"
          }
        },
        "reactions": {
          ".write": true
        },
        "activity": {
          ".write": true
        },
        "presence": {
          "$uid": {
            ".write": true
          }
        }
      }
    }
  }
}

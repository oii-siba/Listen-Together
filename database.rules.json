{
  "rules": {
    "friend_directory": {
      ".read": true,
      "$code": {
        ".write": true
      }
    },
    "friend_directory_uids": {
      ".read": true,
      "$uid": {
        ".write": true
      }
    },
    "users": {
      "$uid": {
        ".read": true,
        ".write": true,
        "friends": {
          ".read": true,
          ".write": true,
          "$fuid": {
            ".write": true
          }
        },
        "notifications": {
          ".read": true,
          ".write": true,
          "$nid": {
            ".write": true
          }
        }
      }
    },
    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": true,
        "chat": {
          ".read": true,
          ".write": true,
          "$mid": {
            ".write": true
          }
        },
        "reactions": {
          ".read": true,
          ".write": true,
          "$rid": {
            ".write": true
          }
        },
        "activity": {
          ".read": true,
          ".write": true,
          "$aid": {
            ".write": true
          }
        },
        "presence": {
          "$uid": {
            ".read": true,
            ".write": true
          }
        }
      }
    }
  }
}

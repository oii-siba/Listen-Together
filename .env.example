# Firebase console -> Project settings -> Your apps -> Web app -> Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# Optional: YouTube Data API v3 key, only for song SEARCH (pasting links works without it).
# Vite env vars are public in the built site, so restrict this key by HTTP referrer
# and to "YouTube Data API v3" only in Google Cloud Console.
VITE_YOUTUBE_API_KEY=
